# --- Required: Supabase project (create one free at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings -> API -> service_role key. SERVER-ONLY. Never expose to
# the browser, never prefix with NEXT_PUBLIC_. Used by admin routes and the
# seed script to bypass RLS for legitimate privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional ---
# Raises the unauthenticated GitHub API rate limit (60/hr -> 5,000/hr) used
# by the GitHub profile verification feature (src/lib/github.ts). Create a
# fine-grained PAT with no scopes (public read-only is enough).
# GITHUB_TOKEN=
