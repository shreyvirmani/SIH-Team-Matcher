# Secret used to sign session JWTs. Generate a long random string for production.
JWT_SECRET=

# --- Production (Supabase) migration placeholders ---
# When migrating from the local SQLite dev store to real Supabase, set these
# and swap src/lib/db.ts / src/lib/auth.ts for Supabase client calls per the
# schema in src/db/schema.postgres.sql.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
